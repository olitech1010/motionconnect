# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Hubtel (Server-side only)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_AUTH_TOKEN=
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_MOCK=false

# MikroTik (Server-side only — use Starlink static IP in production)
MIKROTIK_HOST=<router-static-ip>
MIKROTIK_PORT=443
MIKROTIK_USERNAME=<router-api-user>
MIKROTIK_PASSWORD=<router-api-password>
MIKROTIK_MOCK=false

# App (no need to set in Vercel — auto-detected via VERCEL_URL)

# Seed
ADMIN_SEED_EMAIL=admin@motionconect.com
ADMIN_SEED_PASSWORD=00000000
